Meta.DisplayName=Unciv (TeamKit)
Meta.Description=Serveur multijoueur officiel d'Unciv (Civilization V libre), UncivServer.jar telecharge depuis les releases GitHub du jeu. C'est un serveur HTTP de fichiers de parties : les joueurs (PC et Android) mettent son adresse http://IP:port dans Options > Multijoueur du jeu. Un seul port TCP. Pas de liste de joueurs dans AMP : le jeu ne garde aucune connexion ouverte, il depose et relit les parties tour par tour.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit, d'apres le template Mindustry de CubeCoders (Greelan)
Meta.URL=https://github.com/hydrocut/AMPTemplates-Unciv
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/yairm210/Unciv/master/android/uncivicon-playstore.png
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=uncivconfig.json
Meta.MetaConfigManifest=uncivmetaconfig.json
Meta.ConfigRoot=unciv.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://github.com/yairm210/Unciv/blob/master/docs/Other/Multiplayer.md
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=e7675da4-2715-4bd6-8184-02471db35a34
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
